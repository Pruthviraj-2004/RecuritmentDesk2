# RecruitmentDesk configuration. Copy to .env (docker compose) and backend\.env (local development).
# NEVER commit real values. Nothing here is exposed to the browser: the frontend reads no environment secrets.

# ---- Application -------------------------------------------------------------------------------------------
APP_ENV=development                      # development | production (production enforces secure settings at startup)
APP_NAME=RecruitmentDesk
FRONTEND_URL=http://localhost:5173       # compose: http://localhost:8080 ; used for OAuth return redirect + CORS
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=                            # optional, comma separated. Defaults to FRONTEND_URL. "*" is rejected.

# ---- Database / queue --------------------------------------------------------------------------------------
# Local dev (backend\.env). Docker compose builds its own DATABASE_URL from POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://recruitment:recruitment@localhost:5432/recruitmentdesk
DATABASE_SCHEMA=                         # optional PostgreSQL schema, e.g. "recruitmentdesk" on a shared database (Neon)
POSTGRES_PASSWORD=change-me-too          # docker compose only
REDIS_URL=redis://localhost:6379/0       # empty = run background tasks inline inside the API process (dev only)
CELERY_EAGER=false

# ---- Secrets (generate with: powershell scripts\generate-keys.ps1) ------------------------------------------
SECRET_KEY=                              # >= 32 random characters
ENCRYPTION_KEY=                          # Fernet key (urlsafe base64, 32 bytes) used to encrypt Gmail tokens at rest
SESSION_COOKIE_NAME=rd_session
SESSION_COOKIE_SECURE=false              # MUST be true behind HTTPS in production
SESSION_COOKIE_SAMESITE=lax              # lax | strict
SESSION_TTL_HOURS=12

# ---- Google OAuth (Gmail API) ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/email-accounts/oauth/callback
GOOGLE_PUBSUB_TOPIC=                     # optional future enhancement; polling + reconciliation work without it

# ---- AI extraction (optional: the app runs without it; extraction waits until configured) -----------------
AI_PROVIDER=none                         # none | openai_compatible   ("mock" exists for automated tests only)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1    # any OpenAI-compatible /chat/completions endpoint
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

# ---- Storage -----------------------------------------------------------------------------------------------
STORAGE_BACKEND=local                    # only "local" is implemented
STORAGE_PATH=./data/storage              # exports and extracted attachment text (private; never served statically)

# ---- First administrator (optional bootstrap) --------------------------------------------------------------
# If set AND no user exists, the API creates this admin at startup. Remove them from .env afterwards.
# Preferred alternative: python -m app.cli create-admin --email you@example.com  (prompts for the password)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ORG_NAME=My Recruitment Desk

# ---- Sync / limits / retention -----------------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=15
GMAIL_REQUESTS_PER_SECOND=4                # max Gmail API calls per second; lower = gentler on big mailboxes (a message fetch costs 5 of Gmail's 250 units/second)
GMAIL_MAX_RETRIES=6                         # in-call retries with exponential backoff on rate limits / server errors
INITIAL_IMPORT_DAYS=30
MAX_IMPORT_DAYS=365
MAX_ATTACHMENT_SIZE_MB=15                # larger attachments are skipped (marked "too large")
MAX_ATTACHMENTS_PER_MESSAGE=10
MAX_DELIVERY_ATTACHMENT_MB=20            # Gmail's own limit is 25 MB
EMAIL_BODY_RETENTION_DAYS=90
EXPORT_RETENTION_DAYS=14
